    {
      "id": "eyeFar",
      "text": "વીસ સેકન્ડ સુધી દૂર જુઓ. ધીમેથી આંખો પટપટાવો."
    },
    {
      "id": "eyePalm",
      "text": "હવે પામિંગ. હથેળીઓ બંધ આંખો પર હળવેથી રાખો, અને ધીમે શ્વાસ લો."
    },
    {
      "id": "eyeDone",
      "text": "થઈ ગયું. તમારી આંખોને આરામ મળ્યો."
    },
    {
      "id": "getReady",
      "text": "તૈયાર થાઓ."
    },
    {
      "id": "breatheIn",
      "text": "શ્વાસ અંદર"
    },
    {
      "id": "breathePause",
      "text": "રોકાઓ"
    },
    {
      "id": "breatheOut",
      "text": "શ્વાસ બહાર"
    },
    {
      "id": "breatheDone",
      "text": "ખૂબ સરસ."
    },
    {
      "id": "breakStart",
      "text": "એક મિનિટનો બ્રેક લો. ધીમે શ્વાસ લો, અને દૂર જુઓ."
    },
    {
      "id": "breakDone",
      "text": "બ્રેક પૂરો. તમારી જગ્યા સેવ છે. તૈયાર હો ત્યારે આગળ વાંચો."
    }
