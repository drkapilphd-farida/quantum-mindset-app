{
  "lang": "kn",
  "review": "pending",
  "lines": [
    {
      "id": "common-01",
      "phase": "settle",
      "text": "ಆರಾಮವಾಗಿ ಕುಳಿತುಕೊಳ್ಳಿ, ... ಮತ್ತು ನಿಧಾನವಾಗಿ ಕಣ್ಣು ಮುಚ್ಚಿ."
    },
    {
      "id": "common-02",
      "phase": "settle",
      "text": "ನಿಧಾನವಾಗಿ, ... ಆಳವಾಗಿ ಉಸಿರು ಎಳೆದುಕೊಳ್ಳಿ... ಮತ್ತು ಬಿಟ್ಟುಬಿಡಿ."
    },
    {
      "id": "common-03",
      "phase": "settle",
      "text": "ನಿಮ್ಮ ದೇಹ ಸಡಿಲವಾಗಲಿ, ... ಮತ್ತು ಮನಸ್ಸು ಶಾಂತವಾಗಲಿ."
    },
    {
      "id": "common-04",
      "phase": "settle",
      "text": "ಸುಮ್ಮನೆ ಉಸಿರಾಡಿ, ... ಈ ಶಾಂತಿಯಲ್ಲಿ, ... ಇನ್ನೊಂದು ಕ್ಷಣ."
    },
    {
      "id": "common-05",
      "phase": "settle",
      "text": "ನೀವು ಇಲ್ಲಿ ಸುರಕ್ಷಿತವಾಗಿದ್ದೀರಿ. ನೀವು ಆರಂಭಿಸಲು ಸಿದ್ಧರಿದ್ದೀರಿ."
    },
    {
      "id": "common-06",
      "phase": "build",
      "text": "ಈಗ ನಿಮ್ಮ ಮನೆಯ ಮುಖ್ಯ ಬಾಗಿಲನ್ನು ಕಲ್ಪಿಸಿಕೊಳ್ಳಿ. ... ಅದರ ಬಣ್ಣ, ... ಅದರ ಹಿಡಿಕೆ, ... ಅದು ತೆರೆಯುವ ರೀತಿಯನ್ನು ನೋಡಿ."
    },
    {
      "id": "common-07",
      "phase": "build",
      "text": "ಈ ಮನೆ ನಿಮ್ಮ ಸ್ಮೃತಿ ಅರಮನೆ. ... ಇದರ ಪ್ರತಿಯೊಂದು ಜಾಗವೂ ನಿಮಗಾಗಿ ಏನನ್ನಾದರೂ ಕಾಯ್ದಿಡಬಲ್ಲದು."
    },
    {
      "id": "common-08",
      "phase": "build",
      "text": "ನಾವು ಪ್ರತಿ ಬಾರಿಯೂ ಒಂದೇ ದಾರಿಯಲ್ಲಿ ನಡೆಯುತ್ತೇವೆ, ... ಹಾಗಾಗಿ ನಿಮ್ಮ ಮನಸ್ಸಿಗೆ ಯಾವಾಗಲೂ ದಾರಿ ಗೊತ್ತಿರುತ್ತದೆ."
    },
    {
      "id": "common-09",
      "phase": "place",
      "text": "ಪ್ರತಿಯೊಂದು ವಸ್ತುವನ್ನೂ ದೊಡ್ಡದಾಗಿ, ... ಹೊಳೆಯುವಂತೆ, ... ಮತ್ತು ಸ್ವಲ್ಪ ವಿಚಿತ್ರವಾಗಿ ಕಲ್ಪಿಸಿ. ... ವಿಚಿತ್ರ ಚಿತ್ರಗಳು ಮನಸ್ಸಿನಲ್ಲಿ ಉಳಿಯುತ್ತವೆ."
    },
    {
      "id": "common-10",
      "phase": "place",
      "text": "ಅದನ್ನು ಅಲ್ಲೇ ಬಿಟ್ಟು, ... ಮುಂದೆ ನಡೆಯಿರಿ."
    },
    {
      "id": "common-11",
      "phase": "walk-back",
      "text": "ಈಗ ನಿಮ್ಮ ಮುಖ್ಯ ಬಾಗಿಲಿಗೆ ಹಿಂತಿರುಗಿ. ... ಅದೇ ದಾರಿಯಲ್ಲಿ ಮತ್ತೆ ನಡೆಯಿರಿ, ... ನಿಧಾನವಾಗಿ."
    },
    {
      "id": "common-12",
      "phase": "walk-back",
      "text": "ಪ್ರತಿ ಜಾಗದಲ್ಲೂ, ... ಸುತ್ತಲೂ ನೋಡಿ. ... ಅಲ್ಲಿ ನೀವು ಏನನ್ನು ಬಿಟ್ಟಿದ್ದೀರಿ?"
    },
    {
      "id": "common-13",
      "phase": "recall",
      "text": "ನೀವು ಸಿದ್ಧರಾದಾಗ ಕಣ್ಣು ತೆರೆಯಿರಿ, ... ಮತ್ತು ನಿಮಗೆ ಸಿಕ್ಕಿದ್ದನ್ನು ತೋರಿಸಿ."
    },
    {
      "id": "common-14",
      "phase": "delayed",
      "text": "ಇಂದು ಮುಗಿಸುವ ಮೊದಲು, ... ಮತ್ತೊಮ್ಮೆ ಕಣ್ಣು ಮುಚ್ಚಿ ... ನಿಮ್ಮ ಅರಮನೆಯಲ್ಲಿ ನಡೆಯಿರಿ."
    },
    {
      "id": "common-15",
      "phase": "close",
      "text": "ನಿಮ್ಮ ಅರಮನೆ ಯಾವಾಗಲೂ ನಿಮ್ಮೊಂದಿಗಿದೆ. ... ನೀವು ಅದರಲ್ಲಿ ಹೆಚ್ಚು ನಡೆದಷ್ಟೂ, ... ಅದು ಹೆಚ್ಚು ಬಲವಾಗುತ್ತದೆ."
    },
    {
      "id": "common-16",
      "phase": "close",
      "text": "ನೀವು ಸಿದ್ಧರಾದಾಗ, ... ನಿಧಾನವಾಗಿ ಕಣ್ಣು ತೆರೆಯಿರಿ."
    },
    {
      "id": "common-17",
      "phase": "next-day",
      "text": "ಮತ್ತೆ ಸ್ವಾಗತ. ... ಇಂದಿನ ಅಭ್ಯಾಸದ ಮೊದಲು, ... ನಿನ್ನೆಯ ಅರಮನೆಯಲ್ಲಿ ನಡೆಯಿರಿ. ... ಪ್ರತಿ ಜಾಗದಲ್ಲಿ ಇನ್ನೂ ಏನು ಕಾಯುತ್ತಿದೆ?"
    },
    {
      "id": "place-01",
      "phase": "place",
      "text": "ನೀವು ಮುಖ್ಯ ಬಾಗಿಲಿನಲ್ಲಿದ್ದೀರಿ."
    },
    {
      "id": "place-02",
      "phase": "place",
      "text": "ಹಜಾರಕ್ಕೆ ಕಾಲಿಡಿ."
    },
    {
      "id": "place-03",
      "phase": "place",
      "text": "ಹಾಲ್‌ಗೆ ನಡೆಯಿರಿ."
    },
    {
      "id": "place-04",
      "phase": "place",
      "text": "ಅಡುಗೆಮನೆಗೆ ಹೋಗಿ."
    },
    {
      "id": "place-05",
      "phase": "place",
      "text": "ನಿಮ್ಮ ಮಲಗುವ ಕೋಣೆಗೆ ಪ್ರವೇಶಿಸಿ."
    },
    {
      "id": "place-06",
      "phase": "place",
      "text": "ಈಗ ಸ್ನಾನಗೃಹಕ್ಕೆ ಹೋಗಿ."
    },
    {
      "id": "place-07",
      "phase": "place",
      "text": "ಹೊರಗೆ ಬಾಲ್ಕನಿಗೆ ಬನ್ನಿ."
    },
    {
      "id": "place-08",
      "phase": "place",
      "text": "ನಿಮ್ಮ ಓದುವ ಮೇಜಿನ ಬಳಿ ಕುಳಿತುಕೊಳ್ಳಿ."
    },
    {
      "id": "place-09",
      "phase": "place",
      "text": "ಊಟದ ಮೇಜಿನ ಬಳಿ ಹೋಗಿ."
    },
    {
      "id": "place-10",
      "phase": "place",
      "text": "ಕಿಟಕಿಯ ಬಳಿ ನಿಲ್ಲಿ."
    },
    {
      "id": "object-1-01",
      "phase": "object",
      "text": "ಒಂದು ದೊಡ್ಡ ಮಾವಿನಹಣ್ಣು, ... ಚಿನ್ನದಂತೆ ಹೊಳೆಯುತ್ತಿದೆ."
    },
    {
      "id": "object-1-02",
      "phase": "object",
      "text": "ಒಂದು ಕೆಂಪು ಛತ್ರಿ, ... ನೀರು ತೊಟ್ಟಿಕ್ಕುತ್ತಿದೆ."
    },
    {
      "id": "object-1-03",
      "phase": "object",
      "text": "ಸ್ಟೀಲ್ ಕೆಟಲ್, ... ಜೋರಾಗಿ ಸೀಟಿ ಹೊಡೆಯುತ್ತಿದೆ."
    },
    {
      "id": "object-1-04",
      "phase": "object",
      "text": "ಒಂದು ಅಲಾರಂ ಗಡಿಯಾರ, ... ಬಾರಿಸುತ್ತಾ ಕುಣಿಯುತ್ತಿದೆ."
    },
    {
      "id": "object-1-05",
      "phase": "object",
      "text": "ಕೀಲಿಗಳ ದೊಡ್ಡ ಗೊಂಚಲು, ... ಝಣಝಣಿಸುತ್ತಿದೆ."
    },
    {
      "id": "object-1-06",
      "phase": "object",
      "text": "ಬಿಸಿ ರೊಟ್ಟಿಗಳ ಎತ್ತರದ ರಾಶಿ."
    },
    {
      "id": "object-1-07",
      "phase": "object",
      "text": "ಒಂದು ಹಸಿರು ಗಿಳಿ, ... ಮಾತನಾಡುತ್ತಿದೆ."
    },
    {
      "id": "object-1-08",
      "phase": "object",
      "text": "ನಿಮಗಿಂತ ಎತ್ತರದ ಒಂದು ಮೇಣದಬತ್ತಿ."
    },
    {
      "id": "object-1-09",
      "phase": "object",
      "text": "ಮೊಟ್ಟೆಗಳ ಒಂದು ಬುಟ್ಟಿ, ... ಅಲುಗಾಡುತ್ತಿದೆ."
    },
    {
      "id": "object-1-10",
      "phase": "object",
      "text": "ಒಂದು ಮೊಬೈಲ್ ಫೋನ್, ... ಮತ್ತೆ ಮತ್ತೆ ಕಂಪಿಸುತ್ತಿದೆ."
    },
    {
      "id": "object-2-01",
      "phase": "object",
      "text": "ಬೂಟು ಹಾಕಿಕೊಂಡ, ... ಒಂದು ಪುಟ್ಟ ಆನೆ."
    },
    {
      "id": "object-2-02",
      "phase": "object",
      "text": "ಹೂವುಗಳಿಂದ ತುಂಬಿದ, ... ಒಂದು ಆಟೋ-ರಿಕ್ಷಾ."
    },
    {
      "id": "object-2-03",
      "phase": "object",
      "text": "ಕಾಮನಬಿಲ್ಲಿನ ಬಣ್ಣದ ಒಂದು ಗಾಳಿಪಟ."
    },
    {
      "id": "object-2-04",
      "phase": "object",
      "text": "ಮಂಜುಗಡ್ಡೆಯ ಒಂದು ತುಂಡು, ... ವೇಗವಾಗಿ ಕರಗುತ್ತಿದೆ."
    },
    {
      "id": "object-2-05",
      "phase": "object",
      "text": "ಮರದಷ್ಟು ಎತ್ತರದ, ... ಒಂದು ಸೂರ್ಯಕಾಂತಿ."
    },
    {
      "id": "object-2-06",
      "phase": "object",
      "text": "ರೈಲಿನ ಸೀಟಿ, ... ಮೊಳಗುತ್ತಿದೆ."
    },
    {
      "id": "object-2-07",
      "phase": "object",
      "text": "ಬಕೆಟ್‌ನಲ್ಲಿ ತೇಲುತ್ತಿರುವ, ... ಒಂದು ಕಾಗದದ ದೋಣಿ."
    },
    {
      "id": "object-2-08",
      "phase": "object",
      "text": "ಉಪ್ಪಿನ ಒಂದು ಬೆಟ್ಟ."
    },
    {
      "id": "object-2-09",
      "phase": "object",
      "text": "ಕಪ್‌ನಿಂದ ನೀರು ಕುಡಿಯುತ್ತಿರುವ, ... ಒಂದು ಒಂಟೆ."
    },
    {
      "id": "object-2-10",
      "phase": "object",
      "text": "ಒಂದು ಚಿನ್ನದ ಸೈಕಲ್."
    },
    {
      "id": "object-3-01",
      "phase": "object",
      "text": "ಹಕ್ಕಿಯಂತೆ ರೆಕ್ಕೆ ಬಡಿಯುತ್ತಿರುವ, ... ಒಂದು ಪುಸ್ತಕ."
    },
    {
      "id": "object-3-02",
      "phase": "object",
      "text": "ಪೊರಕೆಯಷ್ಟು ಉದ್ದದ, ... ಒಂದು ಪೆನ್ಸಿಲ್."
    },
    {
      "id": "object-3-03",
      "phase": "object",
      "text": "ವೇಗವಾಗಿ ತಿರುಗುತ್ತಿರುವ, ... ಒಂದು ಗ್ಲೋಬ್."
    },
    {
      "id": "object-3-04",
      "phase": "object",
      "text": "ನಕ್ಷತ್ರಗಳಿಂದ ತುಂಬಿದ, ... ಒಂದು ಕಪ್ಪುಹಲಗೆ."
    },
    {
      "id": "object-3-05",
      "phase": "object",
      "text": "ಹಾಡು ಹಾಡುತ್ತಿರುವ, ... ಒಂದು ಕ್ಯಾಲ್ಕುಲೇಟರ್."
    },
    {
      "id": "object-3-06",
      "phase": "object",
      "text": "ಕಿತ್ತಳೆ ಹಣ್ಣುಗಳಿಂದ ತುಂಬಿದ, ... ಒಂದು ಸ್ಕೂಲ್ ಬ್ಯಾಗ್."
    },
    {
      "id": "object-3-07",
      "phase": "object",
      "text": "ಚಾಕೊಲೇಟ್‌ನಿಂದ ಮಾಡಿದ, ... ಒಂದು ಸ್ಕೇಲ್."
    },
    {
      "id": "object-3-08",
      "phase": "object",
      "text": "ನೀಲಿ ಬಣ್ಣದಲ್ಲಿ ಹೊಳೆಯುತ್ತಿರುವ, ... ಒಂದು ಲ್ಯಾಪ್‌ಟಾಪ್."
    },
    {
      "id": "object-3-09",
      "phase": "object",
      "text": "ನೀರಿನಿಂದ ತುಂಬಿದ, ... ಒಂದು ಟ್ರೋಫಿ."
    },
    {
      "id": "object-3-10",
      "phase": "object",
      "text": "ಬೆಕ್ಕಿನ ಮುಖದ ಮೇಲೆ, ... ಒಂದು ಕನ್ನಡಕ."
    },
    {
      "id": "object-4-01",
      "phase": "object",
      "text": "ತಾನೇ ಬಾರಿಸುತ್ತಿರುವ, ... ಒಂದು ಡೋಲು."
    },
    {
      "id": "object-4-02",
      "phase": "object",
      "text": "ಕಬ್ಬಿನಿಂದ ಮಾಡಿದ, ... ಒಂದು ಕೊಳಲು."
    },
    {
      "id": "object-4-03",
      "phase": "object",
      "text": "ಮೂರು ಪ್ರಕಾಶಮಾನ ಜ್ವಾಲೆಗಳಿರುವ, ... ಒಂದು ದೀಪ."
    },
    {
      "id": "object-4-04",
      "phase": "object",
      "text": "ಕೇಸರಿ ಚೆಂಡು ಹೂವುಗಳ, ... ಒಂದು ಭಾರವಾದ ಹಾರ."
    },
    {
      "id": "object-4-05",
      "phase": "object",
      "text": "ಎಲ್ಲೆಡೆ ಸಿಕ್ಕಿಹಾಕಿಕೊಂಡ, ... ಗಾಳಿಪಟದ ದಾರ."
    },
    {
      "id": "object-4-06",
      "phase": "object",
      "text": "ಪೆಟ್ಟಿಗೆಯೊಳಗೆ ಬಾರಿಸುತ್ತಿರುವ, ... ಒಂದು ಗಂಟೆ."
    },
    {
      "id": "object-4-07",
      "phase": "object",
      "text": "ಚಲಿಸುವ, ... ಒಂದು ಬಣ್ಣದ ರಂಗೋಲಿ."
    },
    {
      "id": "object-4-08",
      "phase": "object",
      "text": "ಕುರ್ಚಿಯಷ್ಟು ದೊಡ್ಡ, ... ಒಂದು ಬುಗುರಿ."
    },
    {
      "id": "object-4-09",
      "phase": "object",
      "text": "ಸಿಹಿತಿಂಡಿಗಳಿಂದ ತುಂಬಿ ತುಳುಕುತ್ತಿರುವ, ... ಒಂದು ಡಬ್ಬಿ."
    },
    {
      "id": "object-4-10",
      "phase": "object",
      "text": "ಕುಣಿಯುತ್ತಿರುವ, ... ಒಂದು ನವಿಲು."
    }
  ]
}
