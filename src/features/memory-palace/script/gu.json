{
  "lang": "gu",
  "review": "pending",
  "lines": [
    {
      "id": "common-01",
      "phase": "settle",
      "text": "આરામથી બેસો, ... અને ધીમેથી આંખો બંધ કરો."
    },
    {
      "id": "common-02",
      "phase": "settle",
      "text": "ધીમે ધીમે, ... ઊંડો શ્વાસ લો... અને છોડી દો."
    },
    {
      "id": "common-03",
      "phase": "settle",
      "text": "તમારા શરીરને ઢીલું પડવા દો, ... અને મનને શાંત થવા દો."
    },
    {
      "id": "common-04",
      "phase": "settle",
      "text": "બસ શ્વાસ લો, ... આ શાંતિમાં, ... હજી એક ક્ષણ."
    },
    {
      "id": "common-05",
      "phase": "settle",
      "text": "તમે અહીં સુરક્ષિત છો. તમે શરૂ કરવા તૈયાર છો."
    },
    {
      "id": "common-06",
      "phase": "build",
      "text": "હવે તમારા ઘરના મુખ્ય દરવાજાની કલ્પના કરો. ... તેનો રંગ, ... તેનું હેન્ડલ, ... અને તે કેવી રીતે ખૂલે છે તે જુઓ."
    },
    {
      "id": "common-07",
      "phase": "build",
      "text": "આ ઘર તમારો સ્મૃતિ-મહેલ છે. ... તેની દરેક જગ્યા તમારા માટે કંઈક સાચવી શકે છે."
    },
    {
      "id": "common-08",
      "phase": "build",
      "text": "આપણે દર વખતે એક જ રસ્તે ચાલીશું, ... જેથી તમારા મનને હંમેશા રસ્તો ખબર રહે."
    },
    {
      "id": "common-09",
      "phase": "place",
      "text": "દરેક વસ્તુને મોટી, ... ચમકદાર, ... અને થોડી અનોખી બનાવો. ... અનોખાં ચિત્રો મનમાં ટકી રહે છે."
    },
    {
      "id": "common-10",
      "phase": "place",
      "text": "તેને ત્યાં જ મૂકી દો, ... અને આગળ ચાલો."
    },
    {
      "id": "common-11",
      "phase": "walk-back",
      "text": "હવે પાછા તમારા મુખ્ય દરવાજે જાઓ. ... એ જ રસ્તે ફરી ચાલો, ... ધીમે ધીમે."
    },
    {
      "id": "common-12",
      "phase": "walk-back",
      "text": "દરેક જગ્યાએ, ... આસપાસ જુઓ. ... તમે ત્યાં શું મૂક્યું હતું?"
    },
    {
      "id": "common-13",
      "phase": "recall",
      "text": "તૈયાર થાઓ ત્યારે આંખો ખોલો, ... અને તમને જે મળ્યું તે બતાવો."
    },
    {
      "id": "common-14",
      "phase": "delayed",
      "text": "આજે પૂરું કરતાં પહેલાં, ... ફરી એક વાર આંખો બંધ કરો ... અને તમારા મહેલમાં ફરો."
    },
    {
      "id": "common-15",
      "phase": "close",
      "text": "તમારો મહેલ હંમેશા તમારી સાથે છે. ... તમે તેમાં જેટલું ફરશો, ... તેટલો તે મજબૂત બનશે."
    },
    {
      "id": "common-16",
      "phase": "close",
      "text": "તમે તૈયાર થાઓ ત્યારે, ... ધીમેથી આંખો ખોલો."
    },
    {
      "id": "common-17",
      "phase": "next-day",
      "text": "ફરી સ્વાગત છે. ... આજના અભ્યાસ પહેલાં, ... ગઈકાલના મહેલમાં ફરો. ... દરેક જગ્યાએ હજી શું રાહ જોઈ રહ્યું છે?"
    },
    {
      "id": "place-01",
      "phase": "place",
      "text": "તમે મુખ્ય દરવાજે છો."
    },
    {
      "id": "place-02",
      "phase": "place",
      "text": "પરસાળમાં પગ મૂકો."
    },
    {
      "id": "place-03",
      "phase": "place",
      "text": "બેઠકરૂમમાં જાઓ."
    },
    {
      "id": "place-04",
      "phase": "place",
      "text": "રસોડામાં જાઓ."
    },
    {
      "id": "place-05",
      "phase": "place",
      "text": "તમારા સૂવાના રૂમમાં પ્રવેશો."
    },
    {
      "id": "place-06",
      "phase": "place",
      "text": "હવે બાથરૂમમાં જાઓ."
    },
    {
      "id": "place-07",
      "phase": "place",
      "text": "બહાર બાલ્કનીમાં આવો."
    },
    {
      "id": "place-08",
      "phase": "place",
      "text": "તમારા અભ્યાસના ટેબલ પર બેસો."
    },
    {
      "id": "place-09",
      "phase": "place",
      "text": "જમવાના ટેબલ પાસે જાઓ."
    },
    {
      "id": "place-10",
      "phase": "place",
      "text": "બારી પાસે ઊભા રહો."
    },
    {
      "id": "object-1-01",
      "phase": "object",
      "text": "એક મોટી કેરી, ... સોના જેવી ચમકતી."
    },
    {
      "id": "object-1-02",
      "phase": "object",
      "text": "એક લાલ છત્રી, ... પાણી ટપકતી."
    },
    {
      "id": "object-1-03",
      "phase": "object",
      "text": "સ્ટીલની કીટલી, ... જોરથી સીટી વગાડતી."
    },
    {
      "id": "object-1-04",
      "phase": "object",
      "text": "એક અલાર્મ ઘડિયાળ, ... વાગતી અને ઊછળતી."
    },
    {
      "id": "object-1-05",
      "phase": "object",
      "text": "ચાવીઓનો મોટો ઝૂડો, ... ખણખણતો."
    },
    {
      "id": "object-1-06",
      "phase": "object",
      "text": "ગરમ રોટલીઓનો ઊંચો થપ્પો."
    },
    {
      "id": "object-1-07",
      "phase": "object",
      "text": "એક લીલો પોપટ, ... બોલતો."
    },
    {
      "id": "object-1-08",
      "phase": "object",
      "text": "તમારા કરતાં ઊંચી એક મીણબત્તી."
    },
    {
      "id": "object-1-09",
      "phase": "object",
      "text": "ઈંડાંની એક ટોપલી, ... ડગમગતી."
    },
    {
      "id": "object-1-10",
      "phase": "object",
      "text": "એક મોબાઇલ ફોન, ... સતત વાગતો."
    },
    {
      "id": "object-2-01",
      "phase": "object",
      "text": "બૂટ પહેરેલો, ... એક નાનકડો હાથી."
    },
    {
      "id": "object-2-02",
      "phase": "object",
      "text": "ફૂલોથી ભરેલી, ... એક રિક્ષા."
    },
    {
      "id": "object-2-03",
      "phase": "object",
      "text": "મેઘધનુષના રંગોવાળો એક પતંગ."
    },
    {
      "id": "object-2-04",
      "phase": "object",
      "text": "બરફની એક પાટ, ... ઝડપથી ઓગળતી."
    },
    {
      "id": "object-2-05",
      "phase": "object",
      "text": "ઝાડ જેટલું ઊંચું, ... એક સૂરજમુખી."
    },
    {
      "id": "object-2-06",
      "phase": "object",
      "text": "ટ્રેનની સીટી, ... વાગતી."
    },
    {
      "id": "object-2-07",
      "phase": "object",
      "text": "ડોલમાં તરતી, ... એક કાગળની હોડી."
    },
    {
      "id": "object-2-08",
      "phase": "object",
      "text": "મીઠાનો એક પહાડ."
    },
    {
      "id": "object-2-09",
      "phase": "object",
      "text": "કપમાંથી પાણી પીતું, ... એક ઊંટ."
    },
    {
      "id": "object-2-10",
      "phase": "object",
      "text": "એક સોનેરી સાયકલ."
    },
    {
      "id": "object-3-01",
      "phase": "object",
      "text": "પક્ષીની જેમ પાંખો ફફડાવતું, ... એક પુસ્તક."
    },
    {
      "id": "object-3-02",
      "phase": "object",
      "text": "સાવરણી જેટલી લાંબી, ... એક પેન્સિલ."
    },
    {
      "id": "object-3-03",
      "phase": "object",
      "text": "ઝડપથી ફરતો, ... એક ગ્લોબ."
    },
    {
      "id": "object-3-04",
      "phase": "object",
      "text": "તારાઓથી ભરેલું, ... એક બ્લેકબોર્ડ."
    },
    {
      "id": "object-3-05",
      "phase": "object",
      "text": "ગીત ગાતું, ... એક કેલ્ક્યુલેટર."
    },
    {
      "id": "object-3-06",
      "phase": "object",
      "text": "સંતરાંથી ભરેલી, ... એક સ્કૂલ બેગ."
    },
    {
      "id": "object-3-07",
      "phase": "object",
      "text": "ચોકલેટની બનેલી, ... એક ફૂટપટ્ટી."
    },
    {
      "id": "object-3-08",
      "phase": "object",
      "text": "વાદળી પ્રકાશમાં ચમકતું, ... એક લેપટોપ."
    },
    {
      "id": "object-3-09",
      "phase": "object",
      "text": "પાણીથી ભરેલી, ... એક ટ્રોફી."
    },
    {
      "id": "object-3-10",
      "phase": "object",
      "text": "બિલાડીના ચહેરા પર, ... એક ચશ્માં."
    },
    {
      "id": "object-4-01",
      "phase": "object",
      "text": "પોતાની મેળે વાગતો, ... એક ઢોલ."
    },
    {
      "id": "object-4-02",
      "phase": "object",
      "text": "શેરડીની બનેલી, ... એક વાંસળી."
    },
    {
      "id": "object-4-03",
      "phase": "object",
      "text": "ત્રણ તેજસ્વી જ્યોતવાળો, ... એક દીવો."
    },
    {
      "id": "object-4-04",
      "phase": "object",
      "text": "કેસરી ગલગોટાના ફૂલોનો, ... એક ભારે હાર."
    },
    {
      "id": "object-4-05",
      "phase": "object",
      "text": "બધે ગૂંચવાયેલી, ... પતંગની દોરી."
    },
    {
      "id": "object-4-06",
      "phase": "object",
      "text": "ડબ્બામાં વાગતી, ... એક ઘંટડી."
    },
    {
      "id": "object-4-07",
      "phase": "object",
      "text": "હલતી, ... એક રંગબેરંગી રંગોળી."
    },
    {
      "id": "object-4-08",
      "phase": "object",
      "text": "ખુરશી જેટલો મોટો, ... એક ભમરડો."
    },
    {
      "id": "object-4-09",
      "phase": "object",
      "text": "મીઠાઈથી છલકાતું, ... એક બોક્સ."
    },
    {
      "id": "object-4-10",
      "phase": "object",
      "text": "નાચતો, ... એક મોર."
    }
  ]
}
