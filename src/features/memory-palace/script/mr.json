{
  "lang": "mr",
  "review": "pending",
  "lines": [
    {
      "id": "common-01",
      "phase": "settle",
      "text": "आरामात बसा, ... आणि हळूच डोळे बंद करा."
    },
    {
      "id": "common-02",
      "phase": "settle",
      "text": "हळूहळू, ... एक खोल श्वास घ्या... आणि सोडून द्या."
    },
    {
      "id": "common-03",
      "phase": "settle",
      "text": "तुमचे शरीर सैल होऊ द्या, ... आणि मन शांत होऊ द्या."
    },
    {
      "id": "common-04",
      "phase": "settle",
      "text": "फक्त श्वास घ्या, ... या शांततेत, ... अजून एक क्षण."
    },
    {
      "id": "common-05",
      "phase": "settle",
      "text": "तुम्ही इथे सुरक्षित आहात. तुम्ही सुरुवात करायला तयार आहात."
    },
    {
      "id": "common-06",
      "phase": "build",
      "text": "आता तुमच्या घराच्या मुख्य दरवाजाची कल्पना करा. ... त्याचा रंग, ... त्याची कडी, ... तो कसा उघडतो ते पाहा."
    },
    {
      "id": "common-07",
      "phase": "build",
      "text": "हे घर तुमचा स्मृती-महाल आहे. ... यातली प्रत्येक जागा तुमच्यासाठी काहीतरी जपून ठेवू शकते."
    },
    {
      "id": "common-08",
      "phase": "build",
      "text": "आपण प्रत्येक वेळी एकाच मार्गाने चालू, ... म्हणजे तुमच्या मनाला नेहमी रस्ता माहीत असेल."
    },
    {
      "id": "common-09",
      "phase": "place",
      "text": "प्रत्येक वस्तू मोठी, ... चमकदार, ... आणि थोडी वेगळीच बनवा. ... वेगळी चित्रं मनात टिकून राहतात."
    },
    {
      "id": "common-10",
      "phase": "place",
      "text": "ती तिथेच ठेवा, ... आणि पुढे चला."
    },
    {
      "id": "common-11",
      "phase": "walk-back",
      "text": "आता परत तुमच्या मुख्य दरवाजाकडे जा. ... त्याच मार्गाने पुन्हा चला, ... हळूहळू."
    },
    {
      "id": "common-12",
      "phase": "walk-back",
      "text": "प्रत्येक जागी, ... आजूबाजूला पाहा. ... तिथे तुम्ही काय ठेवलं होतं?"
    },
    {
      "id": "common-13",
      "phase": "recall",
      "text": "तयार झाल्यावर डोळे उघडा, ... आणि तुम्हाला काय सापडलं ते दाखवा."
    },
    {
      "id": "common-14",
      "phase": "delayed",
      "text": "आज संपवण्यापूर्वी, ... पुन्हा एकदा डोळे बंद करा ... आणि तुमच्या महालात फिरा."
    },
    {
      "id": "common-15",
      "phase": "close",
      "text": "तुमचा महाल नेहमी तुमच्यासोबत आहे. ... तुम्ही त्यात जितके फिराल, ... तितका तो मजबूत होईल."
    },
    {
      "id": "common-16",
      "phase": "close",
      "text": "तुम्ही तयार झाल्यावर, ... हळूच डोळे उघडा."
    },
    {
      "id": "common-17",
      "phase": "next-day",
      "text": "पुन्हा स्वागत आहे. ... आजच्या सरावापूर्वी, ... कालच्या महालात फिरा. ... प्रत्येक जागी अजून काय वाट पाहत आहे?"
    },
    {
      "id": "place-01",
      "phase": "place",
      "text": "तुम्ही मुख्य दरवाजापाशी आहात."
    },
    {
      "id": "place-02",
      "phase": "place",
      "text": "पॅसेजमध्ये पाऊल टाका."
    },
    {
      "id": "place-03",
      "phase": "place",
      "text": "दिवाणखान्यात जा."
    },
    {
      "id": "place-04",
      "phase": "place",
      "text": "स्वयंपाकघरात जा."
    },
    {
      "id": "place-05",
      "phase": "place",
      "text": "तुमच्या झोपण्याच्या खोलीत प्रवेश करा."
    },
    {
      "id": "place-06",
      "phase": "place",
      "text": "आता बाथरूममध्ये जा."
    },
    {
      "id": "place-07",
      "phase": "place",
      "text": "बाहेर बाल्कनीत या."
    },
    {
      "id": "place-08",
      "phase": "place",
      "text": "तुमच्या अभ्यासाच्या टेबलापाशी बसा."
    },
    {
      "id": "place-09",
      "phase": "place",
      "text": "जेवणाच्या टेबलापाशी जा."
    },
    {
      "id": "place-10",
      "phase": "place",
      "text": "खिडकीपाशी थांबा."
    },
    {
      "id": "object-1-01",
      "phase": "object",
      "text": "एक मोठा आंबा, ... सोन्यासारखा चमकणारा."
    },
    {
      "id": "object-1-02",
      "phase": "object",
      "text": "एक लाल छत्री, ... पाणी टपकणारी."
    },
    {
      "id": "object-1-03",
      "phase": "object",
      "text": "स्टीलची किटली, ... जोरात शिट्टी वाजवणारी."
    },
    {
      "id": "object-1-04",
      "phase": "object",
      "text": "एक गजराचं घड्याळ, ... वाजत आणि उड्या मारत."
    },
    {
      "id": "object-1-05",
      "phase": "object",
      "text": "किल्ल्यांचा मोठा जुडगा, ... खणखणणारा."
    },
    {
      "id": "object-1-06",
      "phase": "object",
      "text": "गरम पोळ्यांची उंच चळत."
    },
    {
      "id": "object-1-07",
      "phase": "object",
      "text": "एक हिरवा पोपट, ... बोलणारा."
    },
    {
      "id": "object-1-08",
      "phase": "object",
      "text": "तुमच्यापेक्षा उंच एक मेणबत्ती."
    },
    {
      "id": "object-1-09",
      "phase": "object",
      "text": "अंड्यांची एक टोपली, ... डुलणारी."
    },
    {
      "id": "object-1-10",
      "phase": "object",
      "text": "एक मोबाईल फोन, ... सतत वाजणारा."
    },
    {
      "id": "object-2-01",
      "phase": "object",
      "text": "बूट घातलेला, ... एक छोटासा हत्ती."
    },
    {
      "id": "object-2-02",
      "phase": "object",
      "text": "फुलांनी भरलेली, ... एक रिक्षा."
    },
    {
      "id": "object-2-03",
      "phase": "object",
      "text": "इंद्रधनुष्याच्या रंगांचा एक पतंग."
    },
    {
      "id": "object-2-04",
      "phase": "object",
      "text": "बर्फाची एक लादी, ... भराभर वितळणारी."
    },
    {
      "id": "object-2-05",
      "phase": "object",
      "text": "झाडाएवढं उंच, ... एक सूर्यफूल."
    },
    {
      "id": "object-2-06",
      "phase": "object",
      "text": "रेल्वेची शिट्टी, ... वाजणारी."
    },
    {
      "id": "object-2-07",
      "phase": "object",
      "text": "बादलीत तरंगणारी, ... एक कागदी होडी."
    },
    {
      "id": "object-2-08",
      "phase": "object",
      "text": "मिठाचा एक डोंगर."
    },
    {
      "id": "object-2-09",
      "phase": "object",
      "text": "कपातून पाणी पिणारा, ... एक उंट."
    },
    {
      "id": "object-2-10",
      "phase": "object",
      "text": "एक सोनेरी सायकल."
    },
    {
      "id": "object-3-01",
      "phase": "object",
      "text": "पक्ष्यासारखं पंख फडफडवणारं, ... एक पुस्तक."
    },
    {
      "id": "object-3-02",
      "phase": "object",
      "text": "झाडूएवढी लांब, ... एक पेन्सिल."
    },
    {
      "id": "object-3-03",
      "phase": "object",
      "text": "भराभर फिरणारा, ... पृथ्वीचा एक गोल."
    },
    {
      "id": "object-3-04",
      "phase": "object",
      "text": "चांदण्यांनी भरलेला, ... एक फळा."
    },
    {
      "id": "object-3-05",
      "phase": "object",
      "text": "गाणं गाणारा, ... एक कॅल्क्युलेटर."
    },
    {
      "id": "object-3-06",
      "phase": "object",
      "text": "संत्र्यांनी भरलेली, ... एक शाळेची बॅग."
    },
    {
      "id": "object-3-07",
      "phase": "object",
      "text": "चॉकलेटची बनलेली, ... एक पट्टी."
    },
    {
      "id": "object-3-08",
      "phase": "object",
      "text": "निळ्या प्रकाशात चमकणारा, ... एक लॅपटॉप."
    },
    {
      "id": "object-3-09",
      "phase": "object",
      "text": "पाण्याने भरलेली, ... एक ट्रॉफी."
    },
    {
      "id": "object-3-10",
      "phase": "object",
      "text": "मांजरीच्या चेहऱ्यावर, ... एक चष्मा."
    },
    {
      "id": "object-4-01",
      "phase": "object",
      "text": "आपोआप वाजणारा, ... एक ढोल."
    },
    {
      "id": "object-4-02",
      "phase": "object",
      "text": "उसाची बनलेली, ... एक बासरी."
    },
    {
      "id": "object-4-03",
      "phase": "object",
      "text": "तीन तेजस्वी ज्योतींचा, ... एक दिवा."
    },
    {
      "id": "object-4-04",
      "phase": "object",
      "text": "केशरी झेंडूच्या फुलांचा, ... एक जड हार."
    },
    {
      "id": "object-4-05",
      "phase": "object",
      "text": "सगळीकडे गुंतलेला, ... पतंगाचा मांजा."
    },
    {
      "id": "object-4-06",
      "phase": "object",
      "text": "डब्याच्या आत वाजणारी, ... एक घंटा."
    },
    {
      "id": "object-4-07",
      "phase": "object",
      "text": "हलणारी, ... एक रंगीत रांगोळी."
    },
    {
      "id": "object-4-08",
      "phase": "object",
      "text": "खुर्चीएवढा मोठा, ... एक भोवरा."
    },
    {
      "id": "object-4-09",
      "phase": "object",
      "text": "मिठाईने ओसंडून वाहणारा, ... एक डबा."
    },
    {
      "id": "object-4-10",
      "phase": "object",
      "text": "नाचणारा, ... एक मोर."
    }
  ]
}
