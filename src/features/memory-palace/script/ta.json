{
  "lang": "ta",
  "review": "pending",
  "lines": [
    {
      "id": "common-01",
      "phase": "settle",
      "text": "வசதியாக அமருங்கள், ... மெதுவாகக் கண்களை மூடுங்கள்."
    },
    {
      "id": "common-02",
      "phase": "settle",
      "text": "மெதுவாக, ... ஆழமாக மூச்சை உள்ளிழுங்கள்... பிறகு விடுங்கள்."
    },
    {
      "id": "common-03",
      "phase": "settle",
      "text": "உங்கள் உடல் தளரட்டும், ... உங்கள் மனம் அமைதியாகட்டும்."
    },
    {
      "id": "common-04",
      "phase": "settle",
      "text": "சும்மா மூச்சு விடுங்கள், ... இந்த அமைதியில், ... இன்னும் ஒரு கணம்."
    },
    {
      "id": "common-05",
      "phase": "settle",
      "text": "நீங்கள் இங்கே பாதுகாப்பாக இருக்கிறீர்கள். நீங்கள் தொடங்கத் தயாராக இருக்கிறீர்கள்."
    },
    {
      "id": "common-06",
      "phase": "build",
      "text": "இப்போது உங்கள் வீட்டின் முன்கதவைக் கற்பனை செய்யுங்கள். ... அதன் நிறம், ... அதன் கைப்பிடி, ... அது திறக்கும் விதத்தைப் பாருங்கள்."
    },
    {
      "id": "common-07",
      "phase": "build",
      "text": "இந்த வீடுதான் உங்கள் நினைவு மாளிகை. ... இதன் ஒவ்வொரு இடமும் உங்களுக்காக ஏதாவது ஒன்றை வைத்திருக்க முடியும்."
    },
    {
      "id": "common-08",
      "phase": "build",
      "text": "ஒவ்வொரு முறையும் நாம் ஒரே வழியில் நடப்போம், ... அதனால் உங்கள் மனதுக்கு எப்போதும் வழி தெரியும்."
    },
    {
      "id": "common-09",
      "phase": "place",
      "text": "ஒவ்வொரு பொருளையும் பெரிதாக, ... பளிச்சென்று, ... கொஞ்சம் விசித்திரமாகக் கற்பனை செய்யுங்கள். ... விசித்திரமான படங்கள் மனதில் நிலைத்திருக்கும்."
    },
    {
      "id": "common-10",
      "phase": "place",
      "text": "அதை அங்கேயே வைத்துவிட்டு, ... தொடர்ந்து நடங்கள்."
    },
    {
      "id": "common-11",
      "phase": "walk-back",
      "text": "இப்போது உங்கள் முன்கதவுக்குத் திரும்பிச் செல்லுங்கள். ... அதே வழியில் மீண்டும் நடங்கள், ... மெதுவாக."
    },
    {
      "id": "common-12",
      "phase": "walk-back",
      "text": "ஒவ்வொரு இடத்திலும், ... சுற்றிப் பாருங்கள். ... அங்கே என்ன வைத்தீர்கள்?"
    },
    {
      "id": "common-13",
      "phase": "recall",
      "text": "நீங்கள் தயாரானதும் கண்களைத் திறங்கள், ... நீங்கள் கண்டதைக் காட்டுங்கள்."
    },
    {
      "id": "common-14",
      "phase": "delayed",
      "text": "இன்று முடிப்பதற்கு முன், ... மீண்டும் ஒருமுறை கண்களை மூடி ... உங்கள் மாளிகையில் நடந்து வாருங்கள்."
    },
    {
      "id": "common-15",
      "phase": "close",
      "text": "உங்கள் மாளிகை எப்போதும் உங்களுடன் இருக்கிறது. ... அதில் நீங்கள் எவ்வளவு நடக்கிறீர்களோ, ... அவ்வளவு வலுவாகிறது."
    },
    {
      "id": "common-16",
      "phase": "close",
      "text": "நீங்கள் தயாரானதும், ... மெதுவாகக் கண்களைத் திறங்கள்."
    },
    {
      "id": "common-17",
      "phase": "next-day",
      "text": "மீண்டும் வருக. ... இன்றைய பயிற்சிக்கு முன், ... நேற்றைய மாளிகையில் நடந்து வாருங்கள். ... ஒவ்வொரு இடத்திலும் இன்னும் என்ன காத்திருக்கிறது?"
    },
    {
      "id": "place-01",
      "phase": "place",
      "text": "நீங்கள் முன்கதவில் இருக்கிறீர்கள்."
    },
    {
      "id": "place-02",
      "phase": "place",
      "text": "நடைபாதைக்குள் அடியெடுத்து வையுங்கள்."
    },
    {
      "id": "place-03",
      "phase": "place",
      "text": "வரவேற்பறைக்குள் நடங்கள்."
    },
    {
      "id": "place-04",
      "phase": "place",
      "text": "சமையலறைக்குள் செல்லுங்கள்."
    },
    {
      "id": "place-05",
      "phase": "place",
      "text": "உங்கள் படுக்கையறைக்குள் நுழையுங்கள்."
    },
    {
      "id": "place-06",
      "phase": "place",
      "text": "இப்போது குளியலறைக்குள் செல்லுங்கள்."
    },
    {
      "id": "place-07",
      "phase": "place",
      "text": "வெளியே பால்கனிக்கு வாருங்கள்."
    },
    {
      "id": "place-08",
      "phase": "place",
      "text": "உங்கள் படிக்கும் மேசையில் அமருங்கள்."
    },
    {
      "id": "place-09",
      "phase": "place",
      "text": "சாப்பாட்டு மேசைக்குச் செல்லுங்கள்."
    },
    {
      "id": "place-10",
      "phase": "place",
      "text": "ஜன்னல் அருகே நில்லுங்கள்."
    },
    {
      "id": "object-1-01",
      "phase": "object",
      "text": "ஒரு பெரிய மாம்பழம், ... தங்கமாக ஒளிர்கிறது."
    },
    {
      "id": "object-1-02",
      "phase": "object",
      "text": "ஒரு சிவப்புக் குடை, ... தண்ணீர் சொட்டுகிறது."
    },
    {
      "id": "object-1-03",
      "phase": "object",
      "text": "ஒரு ஸ்டீல் கெட்டில், ... சத்தமாக விசில் அடிக்கிறது."
    },
    {
      "id": "object-1-04",
      "phase": "object",
      "text": "ஒரு அலாரம் கடிகாரம், ... அடித்துக்கொண்டே குதிக்கிறது."
    },
    {
      "id": "object-1-05",
      "phase": "object",
      "text": "சாவிகளின் பெரிய கொத்து, ... கிணுகிணுக்கிறது."
    },
    {
      "id": "object-1-06",
      "phase": "object",
      "text": "சூடான ரொட்டிகளின் உயரமான அடுக்கு."
    },
    {
      "id": "object-1-07",
      "phase": "object",
      "text": "ஒரு பச்சைக் கிளி, ... பேசுகிறது."
    },
    {
      "id": "object-1-08",
      "phase": "object",
      "text": "உங்களைவிட உயரமான ஒரு மெழுகுவர்த்தி."
    },
    {
      "id": "object-1-09",
      "phase": "object",
      "text": "முட்டைகளின் ஒரு கூடை, ... தள்ளாடுகிறது."
    },
    {
      "id": "object-1-10",
      "phase": "object",
      "text": "ஒரு மொபைல் போன், ... விடாமல் அதிர்கிறது."
    },
    {
      "id": "object-2-01",
      "phase": "object",
      "text": "காலணி அணிந்த, ... ஒரு சின்ன யானை."
    },
    {
      "id": "object-2-02",
      "phase": "object",
      "text": "பூக்களால் நிறைந்த, ... ஒரு ஆட்டோ ரிக்‌ஷா."
    },
    {
      "id": "object-2-03",
      "phase": "object",
      "text": "வானவில் நிறங்களில் ஒரு பட்டம்."
    },
    {
      "id": "object-2-04",
      "phase": "object",
      "text": "ஒரு பனிக்கட்டி, ... வேகமாக உருகுகிறது."
    },
    {
      "id": "object-2-05",
      "phase": "object",
      "text": "மரம் அளவு உயரமான, ... ஒரு சூரியகாந்தி."
    },
    {
      "id": "object-2-06",
      "phase": "object",
      "text": "ரயிலின் விசில், ... ஒலிக்கிறது."
    },
    {
      "id": "object-2-07",
      "phase": "object",
      "text": "வாளியில் மிதக்கும், ... ஒரு காகிதப் படகு."
    },
    {
      "id": "object-2-08",
      "phase": "object",
      "text": "உப்பின் ஒரு மலை."
    },
    {
      "id": "object-2-09",
      "phase": "object",
      "text": "கோப்பையில் தண்ணீர் குடிக்கும், ... ஒரு ஒட்டகம்."
    },
    {
      "id": "object-2-10",
      "phase": "object",
      "text": "ஒரு தங்க சைக்கிள்."
    },
    {
      "id": "object-3-01",
      "phase": "object",
      "text": "பறவை போலச் சிறகடிக்கும், ... ஒரு புத்தகம்."
    },
    {
      "id": "object-3-02",
      "phase": "object",
      "text": "துடைப்பம் அளவு நீளமான, ... ஒரு பென்சில்."
    },
    {
      "id": "object-3-03",
      "phase": "object",
      "text": "வேகமாகச் சுழலும், ... ஒரு உலக உருண்டை."
    },
    {
      "id": "object-3-04",
      "phase": "object",
      "text": "நட்சத்திரங்களால் நிறைந்த, ... ஒரு கரும்பலகை."
    },
    {
      "id": "object-3-05",
      "phase": "object",
      "text": "பாட்டுப் பாடும், ... ஒரு கால்குலேட்டர்."
    },
    {
      "id": "object-3-06",
      "phase": "object",
      "text": "ஆரஞ்சுப் பழங்களால் நிறைந்த, ... ஒரு பள்ளிப் பை."
    },
    {
      "id": "object-3-07",
      "phase": "object",
      "text": "சாக்லேட்டால் செய்த, ... ஒரு அளவுகோல்."
    },
    {
      "id": "object-3-08",
      "phase": "object",
      "text": "நீல நிறத்தில் ஒளிரும், ... ஒரு லேப்டாப்."
    },
    {
      "id": "object-3-09",
      "phase": "object",
      "text": "தண்ணீரால் நிறைந்த, ... ஒரு வெற்றிக் கோப்பை."
    },
    {
      "id": "object-3-10",
      "phase": "object",
      "text": "ஒரு பூனையின் முகத்தில், ... ஒரு மூக்குக் கண்ணாடி."
    },
    {
      "id": "object-4-01",
      "phase": "object",
      "text": "தானாகவே அடிக்கும், ... ஒரு மேளம்."
    },
    {
      "id": "object-4-02",
      "phase": "object",
      "text": "கரும்பால் செய்த, ... ஒரு புல்லாங்குழல்."
    },
    {
      "id": "object-4-03",
      "phase": "object",
      "text": "மூன்று பிரகாசமான சுடர்களுடன், ... ஒரு தீபம்."
    },
    {
      "id": "object-4-04",
      "phase": "object",
      "text": "ஆரஞ்சு சாமந்திப் பூக்களின், ... ஒரு கனமான மாலை."
    },
    {
      "id": "object-4-05",
      "phase": "object",
      "text": "எல்லா இடத்திலும் சிக்கிய, ... பட்ட நூல்."
    },
    {
      "id": "object-4-06",
      "phase": "object",
      "text": "பெட்டிக்குள் ஒலிக்கும், ... ஒரு மணி."
    },
    {
      "id": "object-4-07",
      "phase": "object",
      "text": "நகரும், ... ஒரு வண்ணக் கோலம்."
    },
    {
      "id": "object-4-08",
      "phase": "object",
      "text": "நாற்காலி அளவு பெரிய, ... ஒரு பம்பரம்."
    },
    {
      "id": "object-4-09",
      "phase": "object",
      "text": "இனிப்புகளால் நிரம்பி வழியும், ... ஒரு பெட்டி."
    },
    {
      "id": "object-4-10",
      "phase": "object",
      "text": "நடனமாடும், ... ஒரு மயில்."
    }
  ]
}
